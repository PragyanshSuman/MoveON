# Required in production: signs session cookies.
SESSION_SECRET=change-me-to-a-long-random-string

# Phones (E.164) that get the admin panel. Seed admin is +919999999999.
ADMIN_PHONES=+919999999999

# Public base URL used in share links.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# AI photo-to-listing (optional). Without it, the heuristic pricing engine is used.
ANTHROPIC_API_KEY=
# MOVEON_AI_MODEL=claude-opus-5-5

# Razorpay Route (optional). Without keys, the built-in mock payment provider holds funds.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# WhatsApp Business Cloud API (optional). Without it, notifications stay in-app only.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=moveon_update

# Where the JSON data store lives (default ./data).
# MOVEON_DATA_DIR=./data
CRON_SECRET=
